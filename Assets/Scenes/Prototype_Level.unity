  m_Script: {fileID: 11500000, guid: b6dffaeb1f6b7ca4cb5ce48f87980a3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: 'JOB 1: CAPTURE THE RING'
  body: 'GOAL: turn the red ring blue. Two guards defend it, and a ring cannot be
    captured while an enemy is inside it.

    HOW: press ` (all troops), walk into
    the middle of the ring and press Q to plant a guard flag. Your troops gather
    around the flag, fight whatever is near it, and capture the ring. More troops
    capture it faster. Afterwards hold right-click to recall them.

    RESULT: the
    ring turns blue and a banner says OUTPOST CAPTURED.'
  radius: 4
