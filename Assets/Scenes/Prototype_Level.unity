  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: GOLD MINE
  body: 'Send 2 or 3 troops at the mine. Each one carries a load slowly to the glowing
    ring (the depot) to the north, deposits it and walks back to you by itself.

    Press
    Z on the mine first so the group goes to it.'
  radius: 4
