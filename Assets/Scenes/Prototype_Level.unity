MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 531755450}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b6dffaeb1f6b7ca4cb5ce48f87980a3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: THE BOSS
  body: 'GOAL: bring the boss down. It has 3000 health, 6 attach points and hits
    for 60, so troops die fast.

    HOW: send a mixed group and fill all 6 attach
    points. About 5 seconds after troops attach, the boss glows yellow and throws
    them off, so tap right-click to recall them during the glow, then send them back.
    Attack from behind while it is busy for triple damage. At half health, 3 reinforcements
    join. Stun (N) is a test key only.

    RESULT: when it falls, a victory screen
    shows your time and surviving troops.'
  radius: 4
