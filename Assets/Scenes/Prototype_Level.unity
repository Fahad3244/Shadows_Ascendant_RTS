  m_Script: {fileID: 11500000, guid: b6dffaeb1f6b7ca4cb5ce48f87980a3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: STEALTH
  body: 'Three sentries (3 attach points each) only notice you from about 1 unit
    away.

    Sentries A and B face east, away from you. Attack them from behind:
    triple damage (30 instead of 10).

    After the first hit they need about 3
    seconds to react, then they fight back. Kill them fast with a group.

    Sentry
    C faces you: it is still unaware, so it cannot counter, but there is no backstab
    bonus.

    Press Z until one is outlined, then send troops.'
  radius: 4
