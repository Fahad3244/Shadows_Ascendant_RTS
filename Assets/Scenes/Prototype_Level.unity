  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b6dffaeb1f6b7ca4cb5ce48f87980a3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: 'STEP 1: RUNE 1'
  body: 'GOAL: light the first rune pillar, the stone wheel to the west of this pad.

    HOW:
    two guards stand beside it. Deal with them first (press Z on one, hold left-click).
    Then walk up to the wheel and tap left-click twice, one troop each. The number
    counts down 2, 1, 0. At 0 it charges for 4 seconds. If a troop leaves, the charge
    restarts.

    RESULT: the obelisk behind the wheel lights up and rune 2 wakes
    up.'
  radius: 4
