MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 968554055}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b6dffaeb1f6b7ca4cb5ce48f87980a3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: THE BOSS ARENA
  body: 'GOAL: defeat the boss and finish the level.

    HOW: the door is sealed.
    Three stones in front of it light up as you break seals elsewhere in the jungle:
    1) carry the key to the yellow disc in the Carry Yard, 2) capture the ring at
    the Outpost, 3) defeat the temple guardian in the Ruins. The MISSIONS list on
    the left shows which are done.

    RESULT: after the third seal the door opens.
    Rally with recruits at the blue pad first.'
  radius: 4
