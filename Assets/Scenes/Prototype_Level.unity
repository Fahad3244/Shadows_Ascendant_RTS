  m_Script: {fileID: 11500000, guid: b6dffaeb1f6b7ca4cb5ce48f87980a3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: 'JOB 2: THE KEY'
  body: 'GOAL: open the vault. The gold and gear inside are fenced in and troops
    cannot reach them.

    HOW: stand next to the key and tap left-click once. One
    troop carries it to the yellow disc in front of the vault door. (If you used
    Z on it, press X so it can move.)

    RESULT: the key shows Placed, the vault
    door disappears and the loot can be collected.'
  radius: 4
