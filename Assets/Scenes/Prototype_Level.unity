MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 582031356}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b6dffaeb1f6b7ca4cb5ce48f87980a3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: THE ANCIENT RUINS
  body: 'GOAL: wake the temple and defeat its guardian.

    HOW: this is a mission
    with five steps. The MISSIONS list on the left of the screen always shows the
    current one. 1) Light rune 1 (north-east). 2) Light rune 2 (north-west). 3) Carry
    the rune fragment (west) to the yellow disc. 4) Light rune 3 (south-west). 5)
    Enter the temple (south-east). Each step unlocks the next, and each pad tells
    you what to do.

    RESULT: a message appears at every step, and the temple
    door opens after the third rune.'
  radius: 4
