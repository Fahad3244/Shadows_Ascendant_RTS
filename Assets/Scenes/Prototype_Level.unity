  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: BASE CAMP
  body: '1-4 pick the troop type, ` picks all.

    LEFT click tap = send 1 troop,
    hold = send the group.

    RIGHT click tap = recall 1, hold = recall the group.

    Z
    targets what is near you, X clears the target.'
  radius: 4
