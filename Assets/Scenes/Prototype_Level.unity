  m_Script: {fileID: 11500000, guid: b6dffaeb1f6b7ca4cb5ce48f87980a3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: THE WHEEL
  body: 'GOAL: turn the wheel with 3 troops.

    HOW: kill the guards (they charge
    when you come close). Walk up to the wheel and tap left-click 3 times, one troop
    each. The number on the wheel counts down 3, 2, 1, 0. With 1 or 2 troops nothing
    happens.

    RESULT: at 0 the wheel turns for 3 seconds, the troops return and
    the door disappears.'
  radius: 4
