  m_Script: {fileID: 11500000, guid: b6dffaeb1f6b7ca4cb5ce48f87980a3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: 'STEP 4: RUNE 3'
  body: 'GOAL: light the third pillar (the wheel to the west of this pad). It needs
    3 troops.

    HOW: three cultists guard it. Clear them first with a group (hold
    left-click). Then tap left-click 3 times at the wheel. The number counts 3, 2,
    1, 0, and then it charges for 4 seconds.

    RESULT: all three runes burn, the
    temple door opens and its guardian wakes up.'
  radius: 4
