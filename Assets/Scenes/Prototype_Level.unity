--- !u!114 &1090720343
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1090720341}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b6dffaeb1f6b7ca4cb5ce48f87980a3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: THE BAIT
  body: 'GOAL: collect the gold pile to the north-east of this pad.

    HOW: tap-send
    one troop at it. It looks too easy. When the gold is lifted, enemies hidden in
    the trees wake up and charge. Keep a group close and hold left-click to answer
    the ambush. If the carrier dies, the gold drops where it fell and can be picked
    up again.

    RESULT: a banner says AMBUSH, and the gold counts once a troop
    delivers it to you.'
  radius: 4
