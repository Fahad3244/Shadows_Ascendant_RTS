  m_Script: {fileID: 11500000, guid: b6dffaeb1f6b7ca4cb5ce48f87980a3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: 'STEP 3: THE FRAGMENT'
  body: 'GOAL: carry the rune fragment to the yellow disc in the south.

    HOW:
    the fragment appears south of this pad after rune 2 is lit. Walk up to it and
    tap left-click once. One troop carries it to the yellow disc. If you pressed
    Z on it, press X so it can move.

    RESULT: the fragment is placed and rune
    3 wakes up.'
  radius: 4
