  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b6dffaeb1f6b7ca4cb5ce48f87980a3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: 'STEP 2: RUNE 2'
  body: 'GOAL: light the second pillar (the wheel to the south-west of this pad).
    It sleeps until rune 1 is lit.

    HOW: a warden guards it. About 5 seconds
    after troops attach to it, it glows yellow and then throws them off. Tap right-click
    during the glow to recall them, then send them back. Kill the warden first, then
    tap left-click twice at the wheel.

    RESULT: rune 2 lights up and a rune fragment
    appears in the west.'
  radius: 4
