  m_Script: {fileID: 11500000, guid: b6dffaeb1f6b7ca4cb5ce48f87980a3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: S8-K  TURRET ROAR
  body: '1 Press ` (all troops), then press Q: every troop runs to a guard flag.
    With 4 or fewer troops left with you, you are in TURRET MODE: you cannot walk,
    only turn.

    2 Press Y: six enemies surround you and attach (G panel: [OOOO]).

    3
    Press R: a ring expands, the enemies are pushed back and staggered, and your
    attach points empty. They walk back and re-attach.

    EXPECT: R has a 12-second
    cooldown and only works in Turret Mode.'
  radius: 3
