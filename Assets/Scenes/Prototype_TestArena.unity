--- !u!114 &1343510056
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1343510054}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<size=125%><b><color=#7fd1ff>CONTROLS</color></b></size>

    <b><color=#ffd966>MOVE</color></b>

    <color=#9ad>WASD</color>
    move     <color=#9ad>Hold RIGHT mouse + move</color> rotate camera

    <color=#9ad>Esc</color>
    free the mouse cursor


    <b><color=#ffd966>TROOP GROUP</color></b>

    <color=#9ad>`</color>
    All    <color=#9ad>1</color> Builder    <color=#9ad>2</color> Ranged    <color=#9ad>3</color>
    Melee    <color=#9ad>4</color> Medic


    <b><color=#ffd966>COMMANDS</color></b>

    <color=#9ad>LEFT
    click</color> tap = send 1, hold = send group

    <color=#9ad>RIGHT click</color>
    tap = recall 1, hold = recall group

    <color=#9ad>LEFT + RIGHT</color> sweep
    (steer troops directly)

    <color=#9ad>Z</color> target nearest / next    
    <color=#9ad>X</color> clear target

    <color=#9ad>Q</color> guard flag

    <color=#9ad>Ctrl</color>
    hold = plan route, release = save, tap = run


    <b><color=#ffd966>READING
    THE WORLD</color></b>

    Ring number on an enemy = free attach points

    Ring
    number on a movable = troops still needed

    Waypoint ring: <color=#6fa8ff>blue</color>
    yours, <color=#ff6666>red</color> enemy


    <b><color=#ffd966>TEST KEYS</color></b>

    <color=#9ad>G</color>
    combat debug panel     <color=#9ad>Y</color> 6 enemies attack you

    <color=#9ad>N</color>
    stun enemies     <color=#9ad>U</color> human target aware / unaware

    <color=#9ad>E</color>
    wake enemy     <color=#9ad>M</color> killer     <color=#9ad>B</color> open walls    
    <color=#9ad>K / L</color> flip waypoint


    <color=#9ad>F1</color> Hub   <color=#9ad>F2-F9</color>
    stations   <color=#9ad>H</color> hide this   <color=#9ad>F12</color> reset'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
