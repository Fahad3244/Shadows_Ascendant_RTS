  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 255604296}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b6dffaeb1f6b7ca4cb5ce48f87980a3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: S8-A  SHAKE-OFF
  body: 'Press 3 (Melee), press Z, HOLD left-click. Wait.

    EXPECT: about 5 seconds
    after the first troop attaches, the enemy glows yellow for 1.5 seconds, then
    throws every attached troop away. Thrown troops take damage, slide back and show
    a gray ball (stunned). Run it again and RECALL (tap right-click) during the glow:
    that troop is safe.'
  radius: 3
