  m_Script: {fileID: 11500000, guid: b6dffaeb1f6b7ca4cb5ce48f87980a3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: S8-J  COMBINED TEST
  body: '1 Press Z, press 3, TAP once: COUNTERED.

    2 HOLD left-click: OVERWHELMED,
    4 ring + 1 front troop.

    3 Press N: STUNNED, shake-off PAUSED, troops stay
    attached.

    4 TAP right-click: freed point gets reused.

    5 After the stun
    ends: it glows, then throws.

    6 F12, walk behind it, tap: BYPASS BACK.

    7
    Press Y: 6 enemies, [OOOO], no camera spin.'
  radius: 3
