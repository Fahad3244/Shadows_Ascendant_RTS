  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b6dffaeb1f6b7ca4cb5ce48f87980a3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: S3-H  OVERTHROW HOOK
  body: 'Press G: the panel shows ATTACHMENT EVENTS and an Overthrow line. Press
    3, press Z on the tank, and hold-send 5 troops.

    EXPECT: four ATTACHED lines
    (4/4), one FIRST ATTACKER line, and Overthrow ELIGIBLE. The fifth troop is a
    light attacker and gets no ATTACHED line. Press N: STUNNED, Overthrow BLOCKED,
    the troops stay attached. When the stun ends: STUN ENDED, and the shake-off restarts.
    Tap right-click: DETACHED (Disengaged). When the shake-off throws them: DETACHED
    (Thrown), then NO ATTACKERS left.

    This is the hook that Phase 2 Overthrow
    will use.'
  radius: 3
