  m_Script: {fileID: 11500000, guid: b6dffaeb1f6b7ca4cb5ce48f87980a3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: S3-A  FRONT ATTACK
  body: 'Press 3 (Melee), press Z to target the enemy, HOLD left-click.

    EXPECT:
    2 troops attach in the ring, the others attack from the FRONT. Ring troops show
    damage 10, front troops 5. This enemy is UNAWARE: troops behind it show 30 (backstab).
    Press N to stun it for 5 seconds: all hits then do double damage. After about
    5 seconds attached, it glows yellow and then throws every attached troop off
    (damage, knockback, gray ball = stunned). Recall troops during the glow to save
    them.'
  radius: 3
