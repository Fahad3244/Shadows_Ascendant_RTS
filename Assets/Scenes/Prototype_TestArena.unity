  m_Script: {fileID: 11500000, guid: b6dffaeb1f6b7ca4cb5ce48f87980a3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: S7-E  CARRY BLOCKED
  body: 'HOLD left-click so 3+ troops grab the object. Its waypoint is walled in.

    EXPECT:
    the object does NOT move (Blocked) and the troops wait on it. Press B to open
    the walls: it starts moving. Press B again to close them.'
  radius: 3
