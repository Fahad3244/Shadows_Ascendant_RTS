  m_Script: {fileID: 11500000, guid: b6dffaeb1f6b7ca4cb5ce48f87980a3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: S3-D  HUMAN PLAYER RULE
  body: 'The cyan label above the target shows its state. U toggles AWARE / UNAWARE.

    Press
    Z, press 3, TAP once from the pad (you face its front).

    EXPECT: FRONT BLOCKED,
    the troop returns, target loses 5 HP, no knockback, no stun. Press U (UNAWARE)
    and tap: attaches. Walk to its side or back, set AWARE, tap: attaches.'
  radius: 3
