  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b6dffaeb1f6b7ca4cb5ce48f87980a3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArenaHintZone
  title: S3-G  LIGHT vs HEAVY
  body: 'Press G for labels. Stand next to the left enemy (the hunter) and press
    I (light hit): nothing happens. Press J (heavy hit): its label shows INTERRUPTED
    for 1.5 seconds and it freezes.

    EXPECT: ranged troops (press 2) hit it with
    light attacks and never interrupt it. The right enemy (the slammer) hits troops
    with HEAVY attacks: a troop is knocked back and stunned (gray ball), not just
    damaged. Melee troops attached to a target deal attachment damage every second,
    which never interrupts.'
  radius: 3
